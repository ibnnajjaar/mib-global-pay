{
    "name": "ibnnajjaar/mib-global-pay",
    "description": "Framework-agnostic MIB Global integration in PHP",
    "keywords": [
        "ibnnajjaar",
        "mib-global-pay",
        "maldives islamic bank",
        "maldives",
        "bank"
    ],
    "homepage": "https://github.com/ibnnajjaar/mib-global-pay",
    "license": "MIT",
    "authors": [
        {
            "name": "Hussain Afeef",
            "email": "ibnahnajjaar@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "illuminate/support": "Required (^13.0) for the optional Laravel 13 integration layer"
    },
    "autoload": {
        "psr-4": {
            "IbnNajjaar\\MIBGlobalPay\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IbnNajjaar\\MIBGlobalPay\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage-clover=coverage.xml",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test",
        "analyse": [
            "vendor/bin/phpstan analyse",
            "vendor/bin/phpstan analyse -c phpstan-core.neon.dist",
            "vendor/bin/phpstan analyse -c phpstan-laravel.neon.dist --memory-limit=1G"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "IbnNajjaar\\MIBGlobalPay\\Laravel\\MibGlobalPayServiceProvider"
            ],
            "aliases": {
                "MibGlobalPay": "IbnNajjaar\\MIBGlobalPay\\Laravel\\Facades\\MibGlobalPay"
            }
        }
    }
}
