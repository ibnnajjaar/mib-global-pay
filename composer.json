{
    "name": "ibnnajjaar/mib-global-pay",
    "description": "Framework-agnostic MIB Global integration in PHP",
    "keywords": [
        "ibnnajjaar",
        "mib-global-pay",
        "maldives islamic bank",
        "maldives",
        "bank"
    ],
    "homepage": "https://github.com/ibnnajjaar/mib-global-pay",
    "license": "MIT",
    "authors": [
        {
            "name": "Hussain Afeef",
            "email": "ibnahnajjaar@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.4",
        "phpunit/phpunit": "^8.5.42"
    },
    "suggest": {
        "illuminate/support": "Required (^13.0) for the optional Laravel 13 integration layer"
    },
    "autoload": {
        "psr-4": {
            "IbnNajjaar\\MIBGlobalPay\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IbnNajjaar\\MIBGlobalPay\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-clover=coverage.xml",
        "format": "vendor/bin/php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    }
}
