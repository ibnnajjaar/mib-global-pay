# One configuration for all of src (core and Laravel layer), at the strictest level, with Larastan.
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - src
    tmpDir: build/phpstan
    ignoreErrors:
        # Used by host test cases, not by the package itself.
        - identifier: trait.unused
          path: src/Laravel/Testing/InteractsWithMibGlobalPay.php
